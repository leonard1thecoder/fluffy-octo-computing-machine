APP_ENV=development
BIND_ADDR=0.0.0.0:8080
# Local dev (cargo run):
DATABASE_URL=postgres://nhlanganiso:nhlanganiso@localhost:5432/nhlanganiso
# --- Supabase (Postgres) ---
# Long-lived Rust API: use the SESSION-mode pooler (port 5432, supports prepared
# statements). Migrations: use the DIRECT connection (db.[REF].supabase.co:5432),
# never the Tx pooler. Tx pooler (:6543) is for serverless/edge only.
# DATABASE_URL=postgres://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Direct (migrations, pg_dump):
# SUPABASE_DIRECT_URL=postgres://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require
# Pool sizing: keep small against the shared pooler (5 is a safe start).
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
# Unset = auto (0 on :6543 Tx poolers, driver default otherwise). Set 0 explicitly
# if you use the transaction-mode pooler.
# DATABASE_STATEMENT_CACHE_SIZE=0
# Optional project URL (docs/interop only; DATABASE_URL is authoritative for SQLx).
# SUPABASE_URL=https://[REF].supabase.co
# Never put anon/service_role API keys in server env unless using Supabase Auth
# admin APIs; the Rust backend authenticates with its own JWT + owner DB role.
JWT_ISSUER=nhlanganiso-api
JWT_AUDIENCE=nhlanganiso-web
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# 32+ random bytes, base64 or hex. Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME__min_32_bytes__generate_with_openssl_rand_base64_48
# Optional: enables Redis-backed rate limiting. Unset = no limits enforced.
# Upstash: use the rediss:// Redis endpoint (never the https:// REST endpoint).
# Local: docker run -d -p 6379:6379 redis:7-alpine
# REDIS_URL=redis://127.0.0.1:6379
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Gmail API OAuth credentials. The refresh token must be authorized with the
# https://www.googleapis.com/auth/gmail.send scope. Keep these values secret.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=Nhlanganiso Catering and Baking
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
LOG_LEVEL=info
# Comma-separated PayFast ITN source IPs/CIDRs if you need extras (docs: verify sender domain).
PAYFAST_ALLOWED_IPS=
PAYFAST_VALIDATE_IP=true
RATE_LIMIT_GENERAL_PER_MIN=120

# --- Google OAuth 2.0 / OpenID Connect (optional) ---
# Required for /api/v1/auth/google and /api/v1/auth/google/callback.
# Set these only when you have a Google Cloud Console OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Google Cloud Console.
# Google redirects the browser straight to the API host (a top-level navigation
# needs no CORS); the API then redirects back to PUBLIC_WEB_URL with a code.
# Production: https://<api-host>/api/v1/auth/google/callback
# Local dev:  http://localhost:8080/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
# Optional: Google OIDC issuer (defaults to https://accounts.google.com).
# Override for testing against a mock issuer.
GOOGLE_ISSUER=https://accounts.google.com
